<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 麦克风：实时采集环境音 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 前台服务（持续监测需要） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 前台服务使用麦克风必须声明此权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 通知（前台服务通知 / 报警提示） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 保持 CPU 唤醒，避免息屏后采集线程被立刻挂起 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 申请电池优化白名单（后台保活） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".VolmonApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Volmon"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Volmon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.MonitoringService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
            录音转发/分享：Android 7+ 禁止直接传 file:// URI，
            必须经 FileProvider 生成 content:// 授权给目标应用（微信、邮件等）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
